<% layout("/layouts/boilerplate") %>

  <body>
    <div class="row mt-3">
      <div class="col-8 offset-2">
        <h3>Edit your Listing</h3>
        <br />
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation"
          enctype="multipart/form-data" novalidate>
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input value="<%= listing.title %>" name="listing[title]" type="text" class="form-control" required />
            <div class="invalid-feedback">Title is required</div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required>
<%= listing.description %></textarea>
            <div class="invalid-feedback">Description is required</div>
          </div>

          <div class="mb-3">
            <label class="form-label">Current Images</label>
            <% const displayImgs=(listing.images && listing.images.length> 0) ? listing.images : [listing.image]; %>
              <div class="d-flex flex-wrap gap-2 mb-2">
                <% for(let img of displayImgs) { %>
                  <img src="<%= img.url %>" alt="listing image"
                    style="height:80px;width:80px;object-fit:cover;border-radius:0.5rem;" />
                  <% } %>
              </div>
              <label for="edit-images" class="form-label">Add More Images</label>
              <input name="listing[images]" id="edit-images" type="file" class="form-control" multiple
                accept="image/*" />
              <div class="form-text">Selected images will be added to existing ones.</div>
          </div>

          <div class="row">
            <div class="mb-3 col-md-5">
              <label for="price" class="form-label">Price</label>
              <input value="<%= listing.price %>" name="listing[price]" type="number" class="form-control" required />
              <div class="invalid-feedback">Price is required</div>
            </div>

            <div class="mb-3 col-md-7">
              <label for="country" class="form-label">Country</label>
              <input value="<%= listing.country %>" name="listing[country]" type="text" class="form-control" required />
              <div class="invalid-feedback">Country is required</div>
            </div>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input value="<%= listing.location %>" name="listing[location]" type="text" class="form-control" required />
            <div class="invalid-feedback">Location is required</div>
          </div>

          <button class="btn btn-dark edit-btn">Edit</button>
        </form>
      </div>
    </div>
  </body>